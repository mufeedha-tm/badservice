# Local development example. Use deployment-specific values outside local development.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection used by the Express API only.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-a-secure-password
DB_NAME=your-mysql-database

# For production, explicitly set NODE_ENV=production, CLIENT_ORIGIN to the
# production frontend origin, and all DB_* values to the production MySQL
# connection values.
