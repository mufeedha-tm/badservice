# ==========================================
# BadService.in Backend Environment Settings
# ==========================================

# Server port (set automatically by Render in production)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Frontend origin for CORS credentials (e.g. https://badservice.in or http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Set to true on Render production deployment
PRODUCTION=false

# MySQL Database Configuration
DB_HOST=srv843.hstgr.io
DB_PORT=3306
DB_USER=u523277800_badservice_app
DB_PASSWORD=your_database_password
DB_NAME=u523277800_badservice_app

# (Optional) Durable Cloud Object Storage for Proof Uploads
# If omitted, local disk storage at server/uploads/proofs is used
CLOUDINARY_URL=