NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://badservice.in

# Database Configuration (Hostinger MySQL)
DB_HOST=srv843.hstgr.io
DB_PORT=3306
DB_USER=u523277800_badservice_app
DB_PASSWORD=your_database_password
DB_NAME=u523277800_badservice_app

# Official Gmail API Configuration for Transactional Email OTP
# GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
# GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
# GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
# GMAIL_SENDER_EMAIL=no-reply@badservice.in

# OTP Security Parameters
# OTP_METHOD=email
# OTP_SECRET=replace-with-a-cryptographically-secure-random-secret
# OTP_TTL_SECONDS=600
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# Single Admin Account (Backend Authentication)
# Default username: admin
ADMIN_USERNAME=admin
# Set to a bcrypt hash of your admin password; do not store the plaintext password.
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-secure-jwt-secret-key
SESSION_SECRET=replace-with-secure-session-secret-key

# Persistent Object Storage (Cloudinary - Recommended for Production)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
